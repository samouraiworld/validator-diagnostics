# Note: `docker compose up` on a fresh volume takes several extra
# minutes the first time, while the clamav service downloads its virus
# database (the clamav-data volume caches it for subsequent starts).
# The portal waits for clamd to report healthy before it starts, and
# every upload is scanned — if clamd is down, uploads fail closed with a
# 503 rather than being stored unscanned. ClamAV's stream and file size
# limits live in clamd.conf, sized to cover one scan window rather than
# the whole upload; see the README section "Upload size and ClamAV".

# gno.land RPC endpoint used to verify operator public keys (required, no default)
REMOTE=https://rpc.topaz.testnets.gno.land

# Comma-separated bech32 operator addresses allowed to authenticate
# against the admin API — /admin, /admin/submissions, /admin/exercise,
# /admin/summary, the per-submission score endpoint, and the delete
# endpoint. Admins sign in the same challenge-tx way validators do (see
# REMOTE above); an address not in this list gets a 403 even with a
# valid signature.
ADMIN_OPERATOR_ADDRESSES=g1...,g1...

# Optional: hex-encoded HMAC secret for session tokens. Leave unset to
# generate a random one per run (fine for local dev; sessions won't
# survive a restart).
#SESSION_SECRET=

# Optional: hex-encoded HMAC secret for admin session tokens, kept
# separate from SESSION_SECRET so restarting the portal doesn't also
# invalidate in-flight validator upload sessions (or vice versa). Leave
# unset to generate a random one per run.
#ADMIN_SESSION_SECRET=

# MinIO (local S3-compatible storage) admin credentials — also used as
# the portal's S3_ACCESS_KEY / S3_SECRET_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Bucket name, created automatically on startup.
S3_BUCKET=submissions

# Host port the portal is published on.
PORTAL_PORT=8080

# Maximum accepted size of the whole upload, in bytes. The default, 4 GiB,
# is not a scan limit: clamd never sees the raw upload, only metadata.json
# and the decompressed log in 1 GiB windows, so this is a disk/S3/time
# question. Raising it costs disk in particular: uploads over 32 MiB spill
# from memory to a temp file, so free disk has to cover roughly one
# archive's worth of space per concurrent submission. The next limit to
# hit is storage.S3Store.Save's single PutObject, which S3 caps at 5 GiB.
# See the README section "Upload size and ClamAV".
#
# Source of truth: cmd/portal/main.go's defaultMaxUploadSize constant.
# This file can't import a Go constant, so keep the two numbers in step
# by hand.
MAX_UPLOAD_SIZE=4294967296

# Maximum accepted size of the compressed gnoland.log.gz entry inside the
# archive, in bytes (default 4 GiB, matching MAX_UPLOAD_SIZE — a real
# submission's compressed log has been observed above the old 256 MiB
# default). The entry is streamed, never buffered, so this costs
# decompression time rather than memory.
#
# Careful: this bounds the COMPRESSED entry. The DECOMPRESSED log is no
# longer capped by the antivirus — it is scanned in 1 GiB windows, so an
# entry this size decompresses fine either way. Two other bounds apply to
# the decompressed bytes instead, and neither rejects the submission:
# AV_SCAN_BUDGET below (coverage — how much of the log the antivirus
# examines) and scoring.maxLogWindowBytes, 1 GiB (partial credit — how
# much of the investigation window automatic scoring reads).
#
# Source of truth: cmd/portal/main.go's defaultMaxLogSize constant. This
# file can't import a Go constant, so keep the two numbers in step by
# hand.
MAX_LOG_SIZE=4294967296

# How many DECOMPRESSED bytes of gnoland.log.gz the antivirus examines, in
# bytes (default 32 GiB). The log is scanned in 1 GiB windows, so this is
# not a memory cost — it is a time cost, about four minutes at the ~142 MB/s
# clamd manages here.
#
# Exceeding it does not reject the submission: the archive is stored and the
# admin dashboard shows a "scan partiel" badge saying how much was examined.
# Its real job is zip/tar bomb defence.
#
# Source of truth: clamav.DefaultScanBudget. This file can't import a Go
# constant, so keep the two numbers in step by hand.
AV_SCAN_BUDGET=34359738368
